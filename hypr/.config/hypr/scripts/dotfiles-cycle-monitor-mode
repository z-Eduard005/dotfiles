#!/bin/bash
STATE="/tmp/hypr_hdmi_cycle_state"

notify_mode() {
  notify-send "Monitor mode changed" "$1"
}

n=$(cat "$STATE" 2>/dev/null || echo 0)
case $n in
    0)
        dotfiles-monitor-actions monitor high laptop disable
        notify_mode "monitor high, laptop disabled"
        echo 1 > "$STATE"
        ;;
    1)
        dotfiles-monitor-actions monitor low laptop disable
        notify_mode "monitor low, laptop disabled"
        echo 2 > "$STATE"
        ;;
    2)
        dotfiles-monitor-actions monitor disable laptop low
        notify_mode "monitor disabled, laptop low"
        echo 3 > "$STATE"
        ;;
    3)
        dotfiles-monitor-actions monitor high laptop high
        notify_mode "monitor high, laptop high"
        echo 0 > "$STATE"
        ;;
    *)
        echo 0 > "$STATE"
        ;;
esac
