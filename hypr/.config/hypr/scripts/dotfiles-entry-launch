#!/bin/bash
set -euo pipefail

readonly APP_DIRS=(
  "/usr/share/applications"
  "/usr/local/share/applications"
  "$HOME/.local/share/applications"
  "/var/lib/flatpak/exports/share/applications"
  "$HOME/.local/share/flatpak/exports/share/applications"
  "/var/lib/snapd/desktop/applications"
)

readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - launch or focus a desktop application.

usage: ${BOLD}$(basename "$0")${RESET} [${BOLD}--new${RESET}] [VAR=value ...] <desktop-id>

  ${BOLD}--new${RESET}   always start a new instance instead of focusing an existing window
  ${BOLD}help${RESET}    show this help
EOF
}

main() {
  local new=0

  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
  esac

  [[ "${1:-}" == "--new" ]] && new=1 && shift

  [[ $# -eq 1 ]] && eval "set -- $1"

  local -a launch_env=()
  while [[ "${1:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
    launch_env+=("$1")
    shift
  done

  local name dir file exec_line bin class match
  name="${1:-}"

  for dir in "${APP_DIRS[@]}"; do
    file="$dir/$name.desktop"
    if [[ -f "$file" ]]; then
      exec_line="$(grep -m1 '^Exec=' "$file" | cut -d= -f2- || true)"
      exec_line="$(printf '%s\n' "$exec_line" | sed 's/%[a-zA-Z]//g')"
      bin="$(printf '%s\n' "$exec_line" | awk '{ i=1; if ($i == "env") i++; while ($i ~ /^[A-Za-z_][A-Za-z0-9_]*=/) i++; print $i }')"
      bin="$(basename "$bin")"

      class="$(grep -m1 '^StartupWMClass=' "$file" | cut -d= -f2- || true)"
      [[ -z "$class" ]] && class="$name"
      [[ -z "$class" ]] && class="$bin"

      if [[ "$new" -eq 0 ]]; then
        match="$(hyprctl clients -j | jq -r ".[] | select(.class | ascii_downcase == \"${class,,}\") | .address" | head -1 || true)"
        if [[ -z "$match" ]]; then
          match="$(hyprctl clients -j | jq -r ".[] | select(.class | ascii_downcase == \"${name,,}\") | .address" | head -1 || true)"
        fi
        if [[ -n "$match" ]]; then
          hyprctl dispatch "hl.dsp.focus({ window = \"address:$match\" })"
          exit 0
        fi
      fi

      [[ ${#launch_env[@]} -gt 0 ]] && export "${launch_env[@]}"
      eval "set -- $exec_line"
      exec uwsm app -- "$@"
    fi
  done

  printf 'Not found: %s\n' "$name" >&2
  usage >&2
  exit 1
}

main "$@"
