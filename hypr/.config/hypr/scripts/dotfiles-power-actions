#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'
readonly USAGE="{${BOLD}shutdown${RESET}|${BOLD}logout${RESET}|${BOLD}reboot${RESET}}"

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - shut down, log out, or reboot the session.

usage: ${BOLD}$(basename "$0")${RESET} ${USAGE}
EOF
}

do_shutdown() {
  hyprshutdown -t "Shutting down..." --post-cmd "shutdown -P 0"
}

do_logout() {
  hyprshutdown -t "Logging out..."
}

do_reboot() {
  hyprshutdown -t "Rebooting..." --post-cmd "reboot"
}

main() {
  local action="${1:-}"

  case "$action" in
    -h|--help|help)
      usage
      exit 0
      ;;
  esac

  require_hyprland

  case "$action" in
    shutdown|logout|reboot) ;;
    *)
      usage >&2
      exit 1
      ;;
  esac

  require_cmd hyprshutdown

  exec >/dev/null 2>&1 </dev/null

  case "$action" in
    shutdown) do_shutdown ;;
    logout)   do_logout ;;
    reboot)   do_reboot ;;
  esac
}

main "$@"
