#!/bin/bash
set -euo pipefail

readonly STATE_DIR="$HOME/.local/state/dotfiles/youtube-notifier"
readonly CHANNELS="$STATE_DIR/channels"
readonly SEEN="$STATE_DIR/seen"
readonly PIDFILE="$STATE_DIR/pid"
readonly INTERVAL=1440  # 24 minutes
readonly FEED="https://www.youtube.com/feeds/videos.xml?channel_id="
readonly ICON="$HOME/.local/share/icons/yt-icon.png"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

help() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - get a desktop notification when a YouTube channel posts a new video.

Usage:
  ${BOLD}$(basename "$0")${RESET} ${BOLD}start${RESET}             Start watching in the background (checks every $((INTERVAL / 60)) min)
  ${BOLD}$(basename "$0")${RESET} ${BOLD}stop${RESET}              Stop watching
  ${BOLD}$(basename "$0")${RESET} ${BOLD}add${RESET} <channel>     Add a channel (youtube link, @handle)
  ${BOLD}$(basename "$0")${RESET} ${BOLD}remove${RESET} <channel>  Stop watching a channel
  ${BOLD}$(basename "$0")${RESET} ${BOLD}list${RESET}              Show watched channels
  ${BOLD}$(basename "$0")${RESET} ${BOLD}help${RESET}              Show this help
EOF
}

running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(<"$PIDFILE")" 2>/dev/null
}

resolve() {
  local input="$1" handle
  if [[ "$input" =~ UC[A-Za-z0-9_-]{22} ]]; then
    printf '%s\n' "${BASH_REMATCH[0]}"
    return
  fi
  handle="${input#*youtube.com/}"
  handle="${handle#@}"
  handle="${handle%%[/?#]*}"
  curl -fsSL "https://www.youtube.com/@$handle" | grep -oP 'youtube.com/channel/\KUC[\w-]{22}' | head -1
}

add() {
  local id xml name
  id="$(resolve "$1" || true)"
  [[ "$id" =~ ^UC[A-Za-z0-9_-]{22}$ ]] || { printf "Could not find channel: '%s'\n" "$1" >&2; exit 1; }
  grep -q "^$id" "$CHANNELS" 2>/dev/null && { printf 'Already added: %s\n' "$id" >&2; exit 1; }
  xml="$(curl -fsS "$FEED$id")" || { printf 'Channel not found: %s\n' "$id" >&2; exit 1; }
  name="$(grep -m1 -oP '<name>\K[^<]+' <<<"$xml" || true)"
  printf '%s  # %s\n' "$id" "$name" >> "$CHANNELS"
  printf 'Added: %s (%s)\n' "$name" "$id"
}

remove() {
  local id="$1"
  id="$(resolve "$id" || true)"
  grep -q "^$id" "$CHANNELS" 2>/dev/null || { printf 'Not in list: %s\n' "$id" >&2; exit 1; }
  sed -i "/^$id/d" "$CHANNELS"
  rm -f "$SEEN/$id"
  printf 'Removed: %s\n' "$id"
}

list() {
  [[ -s "$CHANNELS" ]] || { printf 'No channels yet.\n'; return; }
  cat "$CHANNELS"
}

watch() {
  local ch xml author id title
  while true; do
    mapfile -t channels < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$CHANNELS")
    for ch in "${channels[@]}"; do
      xml="$(curl -fsS "$FEED$ch")" || continue
      author="$(grep -m1 -oP '<name>\K[^<]+' <<<"$xml" || true)"
      touch "$SEEN/$ch"

      paste -d'\t' \
        <(grep -oP '<yt:videoId>\K[^<]+' <<<"$xml") \
        <(grep -oP '<title>\K[^<]+' <<<"$xml" | tail -n +2) | tac |
      while IFS=$'\t' read -r id title; do
        grep -qx "$id" "$SEEN/$ch" && continue
        printf '%s\n' "$id" >> "$SEEN/$ch"
        title="$(sed 's/&amp;/\&/g; s/&quot;/"/g; s/&#39;/'"'"'/g; s/&lt;/</g; s/&gt;/>/g' <<<"$title")"
        [[ "$(notify-send -i "$ICON" -a "Youtube Channels Notifier" -A watch=Watch "$author" "$title")" == watch ]] && {
          xdg-open "https://www.youtube.com/watch?v=$id" &
          dotfiles-entry-launch app.zen_browser.zen
          swaync-client -t -sw
        }
      done
    done
    sleep "$INTERVAL"
  done
}

start() {
  running && { printf 'Already running\n' >&2; exit 1; }
  [[ -s "$CHANNELS" ]] || { printf 'No channels yet. Add one with: %s add <channel>\n' "$(basename "$0")" >&2; exit 1; }
  watch >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$PIDFILE"
  printf 'Started\n'
}

stop() {
  running || { printf 'Not running\n' >&2; rm -f "$PIDFILE"; exit 1; }
  kill "$(<"$PIDFILE")" || true
  rm -f "$PIDFILE"
  printf 'Stopped\n'
}

main() {
  mkdir -p "$SEEN"

  case "${1:-}" in
    start)      start ;;
    stop)       stop ;;
    add)        [[ -n "${2:-}" ]] || { help; exit 1; }; add "${2:-}" ;;
    remove)     [[ -n "${2:-}" ]] || { help; exit 1; }; remove "${2:-}" ;;
    list)       list ;;
    *)          help ;;
  esac
}

main "$@"
