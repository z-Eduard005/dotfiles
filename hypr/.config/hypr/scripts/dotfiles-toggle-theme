#!/bin/bash
set -euo pipefail

readonly ACCENT_DIR="$HOME/dotfiles/accent-styles-css/.config/accent-styles-css"
readonly WAYBAR_DIR="$HOME/dotfiles/waybar/.config/waybar"
readonly DRAWER_CSS="$HOME/dotfiles/nwg-drawer/.config/nwg-drawer/drawer.css"
readonly KITTY_DIR="$HOME/dotfiles/kitty/.config/kitty"
readonly VICINAE_THEME="$HOME/dotfiles/vicinae/.local/share/vicinae/themes/adwaita-dynamic.toml"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - toggle the desktop between dark and light theme.

usage: ${BOLD}$(basename "$0")${RESET}
EOF
}

set_kitty_keys() {
  local file="$1" value="$2" key
  shift 2
  [[ -f "$file" ]] || return 0
  for key in "$@"; do
    if grep -q "^$key " "$file" 2>/dev/null; then
      sed -i "s/^\($key \+\).*/\1${value}/" "$file" 2>/dev/null || true
    else
      printf '%s %s\n' "$key" "$value" >> "$file" 2>/dev/null || true
    fi
  done
}

toml_set() {
  local file="$1" section="$2" key="$3" value="$4"
  [[ -f "$file" ]] || return 0
  if grep -q "^$key = " "$file" 2>/dev/null; then
    sed -i "s/^\($key = \).*/\1\"$value\"/" "$file" 2>/dev/null || true
  elif grep -q "^\[$section\]$" "$file" 2>/dev/null; then
    sed -i "/^\[$section\]$/a $key = \"$value\"" "$file" 2>/dev/null || true
  else
    { printf '\n[%s]\n%s = "%s"\n' "$section" "$key" "$value" >> "$file" 2>/dev/null; } || true
  fi
}

current_theme() {
  local current
  current="$(gsettings get org.gnome.desktop.interface color-scheme)"
  if [[ "$current" == "'prefer-dark'" ]]; then
    printf 'light'
  else
    printf 'dark'
  fi
}

main() {
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help|help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  fi

  local theme
  theme="$(current_theme)"

  # gsettings
  gsettings set org.gnome.desktop.interface color-scheme "prefer-$theme"

  # waybar & swaync
  ln -sfn "colors-$theme.css" "$ACCENT_DIR/colors/colors-active.css"
  ln -sfn "icons-$theme" "$WAYBAR_DIR/assets/icons-active"
  systemctl --user restart waybar.service
  swaync-client --reload-css >/dev/null

  # nwg-drawer
  local d_bg d_fg
  d_bg="alpha(#222226, 0.95)"
  d_fg="#eeeeee"

  if [[ "$theme" == "dark" ]]; then
    d_bg="alpha(#222226, 0.95)"
    d_fg="#eeeeee"
  else
    d_bg="alpha(#ebebed, 0.95)"
    d_fg="#2f2f34"
  fi
  if [[ -f "$DRAWER_CSS" ]]; then
    sed -i "/^window {/,/^}/ s/^\( *background-color: \).*/\1${d_bg};/" "$DRAWER_CSS" 2>/dev/null || true
    sed -i "/^label {/,/^}/ s/^\( *color: \).*/\1${d_fg};/" "$DRAWER_CSS" 2>/dev/null || true
    grep -qF "background-color: ${d_bg};" "$DRAWER_CSS" 2>/dev/null || printf '\nwindow {\n  background-color: %s;\n}\n' "$d_bg" >> "$DRAWER_CSS" 2>/dev/null || true
    grep -qF "color: ${d_fg};" "$DRAWER_CSS" 2>/dev/null || printf '\nlabel {\n  color: %s;\n}\n' "$d_fg" >> "$DRAWER_CSS" 2>/dev/null || true
  fi

  # kitty
  set_kitty_keys "$KITTY_DIR/dark-theme.auto.conf" "#222226" background selection_foreground
  set_kitty_keys "$KITTY_DIR/light-theme.auto.conf" "#eeeeee" selection_foreground
  set_kitty_keys "$KITTY_DIR/light-theme.auto.conf" "#222226" active_tab_foreground foreground

  # vicinae
  local v_variant v_inherits v_bg v_fg
  v_variant="dark"
  v_inherits="vicinae-dark"
  v_bg="#222226"
  v_fg="#eeeeee"

  if [[ "$theme" == "dark" ]]; then
    v_variant="dark"
    v_inherits="vicinae-dark"
    v_bg="#222226"
    v_fg="#ebebed"
  else
    v_variant="light"
    v_inherits="vicinae-light"
    v_bg="#ebebed"
    v_fg="#222226"
  fi
  toml_set "$VICINAE_THEME" "meta" "variant" "$v_variant"
  toml_set "$VICINAE_THEME" "meta" "inherits" "$v_inherits"
  toml_set "$VICINAE_THEME" "colors.core" "background" "$v_bg"
  toml_set "$VICINAE_THEME" "colors.core" "foreground" "$v_fg"
  vicinae theme set adwaita-dynamic 2>/dev/null || true

  # hyprtoolkit
}

main "$@"
