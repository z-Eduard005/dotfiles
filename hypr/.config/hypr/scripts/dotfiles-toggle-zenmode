#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly KITTY_CONF="$HOME/dotfiles/kitty/.config/kitty/kitty.conf"
readonly WAYBAR_CSS="$HOME/dotfiles/waybar/.config/waybar/style.css"
readonly WAYBAR_LAYOUT="$HOME/dotfiles/waybar/.config/waybar/layout.jsonc"
readonly WAYBAR_MODULES="$HOME/dotfiles/waybar/.config/waybar/modules.jsonc"
readonly VICINAE_SETTINGS="$HOME/dotfiles/vicinae/.config/vicinae/settings.json"
readonly VICINAE_OPACITY_STATE="$HOME/.local/state/dotfiles/hypr/vicinae-opacity"
readonly VICINAE_OPACITY_DEFAULT="0.96"
readonly ZEN_STATE="$HOME/.local/state/dotfiles/hypr/zen-mode"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - toggle zen mode (gaps, kitty cursor trail, waybar sizes and vicinae transparency).

usage: ${BOLD}$(basename "$0")${RESET}
EOF
}

set_cursor_trail() {
  [[ -f "$KITTY_CONF" ]] || return 0
  set_line "$KITTY_CONF" '^[[:space:]]*cursor_trail[[:space:]]' "cursor_trail $1"
  pkill -USR1 -x kitty 2>/dev/null || true
}

set_waybar_zen_css() {
  [[ -f "$WAYBAR_CSS" ]] || return 0
  if [[ "$1" == "on" ]]; then
    sed -i -E 's|^([[:space:]]*)/\*[[:space:]]*(@import "zen-mode\.css";)[[:space:]]*\*/[[:space:]]*$|\1\2|' "$WAYBAR_CSS"
  else
    sed -i -E 's|^([[:space:]]*)(@import "zen-mode\.css";)[[:space:]]*$|\1/* \2 */|' "$WAYBAR_CSS"
  fi
}

set_waybar_sizes() {
  local height ws tray icon
  if [[ "$1" == "on" ]]; then
    height=34; ws=20; tray=18; icon=20
  else
    height=40; ws=24; tray=20; icon=24
  fi

  [[ -f "$WAYBAR_LAYOUT" ]] && sed -i -E "s/^([[:space:]]*\"height\"[[:space:]]*:[[:space:]]*)[0-9]+/\1${height}/" "$WAYBAR_LAYOUT"
  [[ -f "$WAYBAR_MODULES" ]] || return 0

  sed -i -E \
    -e "/^[[:space:]]*\"hyprland\/workspaces\"[[:space:]]*:[[:space:]]*\{/,/^[[:space:]]{0,2}\},?[[:space:]]*$/ s/^([[:space:]]*\"icon-size\"[[:space:]]*:[[:space:]]*)[0-9]+/\1${ws}/" \
    -e "/^[[:space:]]*\"tray\"[[:space:]]*:[[:space:]]*\{/,/^[[:space:]]{0,2}\},?[[:space:]]*$/ s/^([[:space:]]*\"icon-size\"[[:space:]]*:[[:space:]]*)[0-9]+/\1${tray}/" \
    -e "/^[[:space:]]*\"image#(temperature|volume|wifi|bluetooth|battery)\"[[:space:]]*:[[:space:]]*\{/,/^[[:space:]]{0,2}\},?[[:space:]]*$/ s/^([[:space:]]*\"size\"[[:space:]]*:[[:space:]]*)[0-9]+/\1${icon}/" \
    "$WAYBAR_MODULES"
}

vicinae_opacity() {
  local first
  first="$(grep -n -m1 '^[[:space:]]*{' -- "$VICINAE_SETTINGS" 2>/dev/null | cut -d: -f1)"
  [[ -n "$first" ]] || return 0
  tail -n +"$first" -- "$VICINAE_SETTINGS" 2>/dev/null \
    | jq -r '.launcher_window.opacity // empty' 2>/dev/null || true
}

set_vicinae_opacity() {
  local opacity

  [[ -f "$VICINAE_SETTINGS" ]] || return 0
  has vicinae || return 0
  has jq || return 0

  if [[ "$1" == "on" ]]; then
    if [[ ! -f "$VICINAE_OPACITY_STATE" ]]; then
      opacity="$(vicinae_opacity)"
      mkdir -p "$(dirname "$VICINAE_OPACITY_STATE")"
      printf '%s\n' "${opacity:-$VICINAE_OPACITY_DEFAULT}" > "$VICINAE_OPACITY_STATE"
    fi
    jsonc_jq "$VICINAE_SETTINGS" '.launcher_window.opacity = 1.0' || true
  else
    opacity="$(cat "$VICINAE_OPACITY_STATE" 2>/dev/null || true)"
    rm -f -- "$VICINAE_OPACITY_STATE"
    jsonc_jq "$VICINAE_SETTINGS" --argjson o "${opacity:-$VICINAE_OPACITY_DEFAULT}" \
      '.launcher_window.opacity = $o' || true
  fi
}

main() {
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help|help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  fi

  require_hyprland

  local zen
  zen="$(cat "$ZEN_STATE" 2>/dev/null || true)"
  [[ "$zen" == "true" ]] || zen="false"

  if [[ "$zen" == "true" ]]; then
    zen="false"
  else
    zen="true"
  fi

  mkdir -p "$(dirname "$ZEN_STATE")"
  printf '%s\n' "$zen" > "$ZEN_STATE"

  # hyprland reads the zen state on load (gaps, rounding, animations, window rules)
  hyprctl reload 2>/dev/null || true

  # vicinae launcher transparency
  if [[ "$zen" == "true" ]]; then
    set_vicinae_opacity on
  else
    set_vicinae_opacity off
  fi

  # kitty cursor trail
  if has kitty; then
    if [[ "$zen" == "true" ]]; then
      set_cursor_trail 0
    else
      set_cursor_trail 3
    fi
  fi

  # waybar zen-mode css
  if has waybar; then
    if [[ "$zen" == "true" ]]; then
      set_waybar_zen_css on
      set_waybar_sizes on
    else
      set_waybar_zen_css off
      set_waybar_sizes off
    fi
    pkill -USR2 -x waybar 2>/dev/null || true
  fi
}

main "$@"
