#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly THEME_DIR="$HOME/dotfiles/accent-styles-css/.config/accent-styles-css"
readonly ACCENT_STATE="$HOME/.local/state/dotfiles/hypr/accent"
readonly ACCENT_MAP="$HOME/.local/state/dotfiles/hypr/wallpaper-accent-map.txt"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

ACCENT_NAMES=(blue teal green yellow orange red pink purple slate)
readonly ACCENT_NAMES
declare -A ACCENT_HEX=(
  [blue]="#3584e4"
  [teal]="#2190a4"
  [green]="#3a944a"
  [yellow]="#c88800"
  [orange]="#ed5b00"
  [red]="#e62d42"
  [pink]="#d56199"
  [purple]="#9141ac"
  [slate]="#6f8396"
)
readonly ACCENT_HEX

usage() {
  cat <<EOF
usage: ${BOLD}$(basename "$0")${RESET} <command> [args]

commands:
  ${BOLD}switch${RESET} <gnome-accent>  apply an accent
  ${BOLD}get${RESET}                    print the current accent hex
  ${BOLD}wallpaper-extract${RESET}      print the accent that best matches the current wallpaper
  ${BOLD}help${RESET}                   show this help

accents: blue teal green yellow orange red pink purple slate
EOF
}

hex_for() {
  local hex="${ACCENT_HEX[$1]:-}"
  [[ -n "$hex" ]] || return 1
  printf '%s' "$hex"
}

# Blend <hex> towards white or black by <percent> (0-100).
hex_mix() {
  local hex="${1#\#}" percent="$2" target="$3"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  local tr tg tb
  case "$target" in
    white) tr=255; tg=255; tb=255 ;;
    black) tr=0; tg=0; tb=0 ;;
    *) return 1 ;;
  esac
  printf '#%02x%02x%02x' \
    $(((r * (100 - percent) + tr * percent) / 100)) \
    $(((g * (100 - percent) + tg * percent) / 100)) \
    $(((b * (100 - percent) + tb * percent) / 100))
}

set_kitty_keys() {
  local file="$1" value="$2" key
  shift 2
  [[ -f "$file" ]] || return 0
  for key in "$@"; do
    if grep -q "^$key " "$file" 2>/dev/null; then
      sed -i "s/^\($key \+\).*/\1${value}/" "$file" 2>/dev/null || true
    else
      printf '%s %s\n' "$key" "$value" >> "$file" 2>/dev/null || true
    fi
  done
}

set_toml() {
  local file="$1" section="$2" key="$3" value="$4"
  [[ -f "$file" ]] || return 0
  if grep -q "^$key = " "$file" 2>/dev/null \
    || grep -q "^\[$section\]$" "$file" 2>/dev/null; then
    set_line "$file" "^$key = " "$key = \"$value\"" "[$section]" || true
  else
    { printf '\n[%s]\n%s = "%s"\n' "$section" "$key" "$value" >> "$file" 2>/dev/null; } || true
  fi
}

oklab() {
  magick "xc:$1" -colorspace Oklab -format '%[fx:r] %[fx:g] %[fx:b]' info: 2>/dev/null
}

cmd_switch() {
  local accent="$1"
  local hex
  hex="$(hex_for "$accent")" || { usage >&2; exit 2; }

  local css="$THEME_DIR/accents/accent-$accent.css"
  [[ -f "$css" ]] || { usage >&2; exit 2; }

  # gsettings & gtk
  if has gsettings; then
    gsettings set org.gnome.desktop.interface accent-color "$accent"
  fi
  systemctl --user restart xdg-desktop-portal-gtk.service 2>/dev/null || true

  # waybar & swaync
  ln -sfn "accent-$accent.css" "$THEME_DIR/accents/accent-active.css"
  if has waybar; then
    systemctl --user restart waybar.service 2>/dev/null || true
  fi
  if has swaync-client; then
    swaync-client --reload-css >/dev/null 2>&1 || true
  fi

  # hyprland window border
  local border="${hex#\#}"
  if [[ -n "$border" ]]; then
    mkdir -p "$(dirname "$ACCENT_STATE")"
    printf 'rgb(%s)\n' "$border" > "$ACCENT_STATE"
    hyprctl reload 2>/dev/null || true
  fi

  # gdm
  local gdm_dconf="$HOME/dotfiles/.gdm/etc/dconf/db/gdm.d/01-gdm-custom"
  if [[ -f "$gdm_dconf" ]] && grep -qF '[org/gnome/desktop/interface]' "$gdm_dconf"; then
    set_line "$gdm_dconf" '^accent-color=' "accent-color='$accent'" \
      '[org/gnome/desktop/interface]' || true
    sudo -n dconf update 2>/dev/null || true
  fi

  # kitty
  if has kitty && [[ -n "$hex" ]]; then
    set_kitty_keys "$HOME/dotfiles/kitty/.config/kitty/dark-theme.auto.conf" "$hex" cursor color6 selection_background active_tab_background
    set_kitty_keys "$HOME/dotfiles/kitty/.config/kitty/light-theme.auto.conf" "$hex" cursor color6 selection_background active_tab_background
  fi

  # kitty workaround: dark theme does not update accent
  if [[ "$(dotfiles-theme get 2>/dev/null || true)" == "dark" ]]; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-light" 2>/dev/null || true
    sleep 0.1 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
  fi

  # vicinae
  if has vicinae; then
    local vicinae_theme="$HOME/dotfiles/vicinae/.local/share/vicinae/themes/adwaita-dynamic.toml"
    local vicinae_settings="$HOME/dotfiles/vicinae/.config/vicinae/settings.json"
    local icon="Adwaita-$accent"

    if [[ -n "$hex" ]]; then
      set_toml "$vicinae_theme" "colors.core" "accent" "$hex"

      if [[ -f "$vicinae_settings" ]] && [[ -w "$vicinae_settings" ]] && has jq; then
        local jq_dir
        jq_dir="$(mktemp -d 2>/dev/null)" || jq_dir=""
        if [[ -n "$jq_dir" ]]; then
          local first
          first="$(grep -n -m1 '^{' "$vicinae_settings" 2>/dev/null | cut -d: -f1)"
          if [[ -n "$first" ]] \
            && head -n $((first - 1)) "$vicinae_settings" > "$jq_dir/head" 2>/dev/null \
            && tail -n +"$first" "$vicinae_settings" 2>/dev/null | jq --arg icon "$icon" '.theme.dark.icon_theme = $icon | .theme.light.icon_theme = $icon | .theme.dark.name //= "adwaita-dynamic" | .theme.light.name //= "adwaita-dynamic"' > "$jq_dir/body" 2>/dev/null \
            && [[ -s "$jq_dir/body" ]] \
            && cat "$jq_dir/head" "$jq_dir/body" > "$jq_dir/full" 2>/dev/null \
            && ! cmp -s "$jq_dir/full" "$vicinae_settings" 2>/dev/null \
            && cat "$jq_dir/full" > "$vicinae_settings" 2>/dev/null; then
            : # settings updated (header comments preserved, write only on change)
          fi
          rm -rf "$jq_dir" 2>/dev/null || true
        fi
      fi
    fi
    vicinae theme set adwaita-dynamic 2>/dev/null || true
  fi

  # hyprlock
  local lock_conf="$HOME/dotfiles/hypr/.config/hypr/hyprlock.conf"
  if [[ -n "$border" ]] && [[ -f "$lock_conf" ]]; then
    if grep -q '^input-field {' "$lock_conf" 2>/dev/null; then
      if sed -n '/^input-field {/,/^}/p' "$lock_conf" 2>/dev/null | grep -q '^ *outer_color *= *rgb('; then
        sed -i "/^input-field {/,/^}/ s/^\( *outer_color *= *rgb(\)[^)]*/\1${border}/" "$lock_conf" 2>/dev/null || true
      else
        sed -i "/^input-field {$/a \    outer_color = rgb(${border})" "$lock_conf" 2>/dev/null || true
      fi
    else
      printf '\ninput-field {\n    outer_color = rgb(%s)\n}\n' "$border" >> "$lock_conf" 2>/dev/null || true
    fi
  fi

  # telegram workaround: reload to take effect
  flatpak kill org.telegram.desktop 2>/dev/null || true
  hyprctl dispatch 'hl.dsp.exec_cmd("dotfiles-entry-launch org.telegram.desktop", { workspace = "4 silent" })' 2>/dev/null || true

  # hyprtoolkit
  local tk_conf="$HOME/dotfiles/hypr/.config/hypr/hyprtoolkit.conf"
  if [[ -f "$tk_conf" ]] && [[ -n "$hex" ]]; then
    local tk_accent tk_secondary
    if [[ "$("$SCRIPT_DIR/dotfiles-theme" get 2>/dev/null || true)" == "light" ]]; then
      tk_accent="$(hex_mix "$hex" 30 black)"
      tk_secondary="$(hex_mix "$hex" 45 black)"
    else
      tk_accent="$hex"
      tk_secondary="$(hex_mix "$hex" 40 white)"
    fi
    set_line "$tk_conf" '^accent = ' "accent = 0xFF${tk_accent#\#}" || true
    set_line "$tk_conf" '^accent_secondary = ' "accent_secondary = 0xFF${tk_secondary#\#}" || true
    systemctl --user restart hyprpolkitagent.service 2>/dev/null || true
  fi
}

cmd_get() {
  local name hex
  name="$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null || true)"
  name="${name//\'/}"
  hex=""
  if [[ -n "$name" ]]; then
    hex="${ACCENT_HEX[$name]:-}"
  fi
  printf '%s\n' "${hex:-#6f8396}"
}

wallpaper_image() {
  awww query 2>/dev/null | grep -oP 'image: \K.*' | head -1 || true
}

cmd_wallpaper_extract() {
  local img
  require_cmd awww matugen magick

  img="$(wallpaper_image)"

  [[ -n "$img" ]] || { printf 'no wallpaper found\n' >&2; printf 'slate\n'; exit 0; }

  local map="$ACCENT_MAP"
  mkdir -p "$(dirname "$map")"
  [[ -f "$map" ]] || : > "$map" 2>/dev/null || true

  if [[ -f "$map" ]]; then
    local mapped
    mapped="$(awk -v img="$img" '
      substr($0, 1, 1) == "\"" && match($0, /^"[^"]*"/) {
        if (substr($0, 2, RLENGTH - 2) == img) {
          rest = substr($0, RLENGTH + 1)
          sub(/^[ \t]+/, "", rest)
          split(rest, a, /[ \t]+/)
          print a[1]
          exit
        }
      }' "$map")"
    case "$mapped" in
      blue|teal|green|yellow|orange|red|pink|purple|slate)
        if [[ -t 2 ]]; then printf 'map override: %s\n' "$mapped" >&2; fi
        printf '%s\n' "$mapped"
        exit 0
        ;;
    esac
  fi

  local -a cands=()
  local candidate
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] && cands+=("$candidate")
  done < <(matugen image "$img" --dry-run --show-source-colors)

  local winner=""
  if [[ "${#cands[@]}" -gt 0 ]]; then

    declare -A cov=()
    local -a pal=()
    for candidate in "${cands[@]}"; do pal+=(-size 1x1 "xc:$candidate"); done
    while read -r cnt hex tot; do
      [[ -n "$hex" ]] && cov["$hex"]=$(( cnt * 100 / tot ))
    done < <(
      magick "${pal[@]}" +append -write mpr:pal +delete \
        -define jpeg:size=400x400 "$img" -resize 200x200 +dither -remap mpr:pal -format '%c' histogram:info: \
        | awk -v clist="${cands[*]}" '
            { k = toupper(substr($3, 1, 7)); cnt[k] += $1; tot += $1 }
            END {
              n = split(clist, a, " ");
              for (i = 1; i <= n; i++)
                printf "%d %s %d\n", cnt[toupper(a[i])] + 0, toupper(a[i]), tot;
            }'
    )

    # --- perceptual match: Oklab coords once per color, score in awk ---
    # A raw `compare` distance lumps lightness into hue, which made dark
    # wallpapers pick mid-light accents (purple beat slate on a mountain
    # shot).  Hue, chroma and lightness are therefore scored separately:
    #   score = hueSim x chromaSim x lightSim x usage%^POW
    #     hueSim   tolerance 60deg  (same color family)
    #     chromaSim tolerance 0.20  (Oklab chroma units)
    #     lightSim  tolerance 0.60  (Oklab L units)
    #     POW      usage damping: 1 = raw multiplication, 0.5 = balanced.
    #              override per run: ACCENT_USAGE_POW=1 dotfiles-accent wallpaper-extract
    local pow="${ACCENT_USAGE_POW:-0.5}"

    local scores
    scores=$(
      {
        for a in "${ACCENT_NAMES[@]}"; do ( printf 'A %s %s\n' "$a" "$(oklab "${ACCENT_HEX[$a]}")" ) & done
        for candidate in "${cands[@]}"; do ( printf 'C %s %s %s\n' "${candidate^^}" "$(oklab "$candidate")" "${cov[${candidate^^}]:-0}" ) & done
        wait || true
      } | awk -v pow="$pow" '
        $1 == "A" { nm = $2; LA[nm] = $3; AA[nm] = $4 - 0.5; BB[nm] = $5 - 0.5; ord[++n] = nm }
        $1 == "C" { CL[$2] = $3; CA[$2] = $4 - 0.5; CB[$2] = $5 - 0.5; CV[$2] = $6; cs[++m] = $2 }
        END {
          if (n * m == 0) exit
          PI = 3.14159265
          for (i = 1; i <= n; i++) {
            nm = ord[i]
            for (j = 1; j <= m; j++) {
              c = cs[j]
              dh = atan2(BB[nm], AA[nm]) - atan2(CB[c], CA[c])
              if (dh >  PI) dh -= 2 * PI
              if (dh < -PI) dh += 2 * PI
              dh *= 180 / PI; if (dh < 0) dh = -dh
              hue = 1 - dh / 60;   if (hue < 0) hue = 0; if (hue > 1) hue = 1
              ca = sqrt(AA[nm] * AA[nm] + BB[nm] * BB[nm])
              cc = sqrt(CA[c] * CA[c] + CB[c] * CB[c])
              dc = ca - cc;        if (dc < 0) dc = -dc
              chr = 1 - dc / 0.2;  if (chr < 0) chr = 0; if (chr > 1) chr = 1
              dl = LA[nm] - CL[c]; if (dl < 0) dl = -dl
              lit = 1 - dl / 0.6;  if (lit < 0) lit = 0; if (lit > 1) lit = 1
              printf "%.4f %s\n", hue * chr * lit * (CV[c] ^ pow), nm
            }
          }
        }' | sort -rn
    )

    if [[ -t 2 ]] && [[ -n "$scores" ]]; then
      printf 'top scores (Oklab hue x chroma x light x usage%%^%s):\n' "$pow" >&2
      printf '%s\n' "$scores" | head -3 | sed 's/^/  /' >&2
    fi
    # best score must be > 0 (all-zero means measuring failed, not a real result)
    winner="$(printf '%s\n' "$scores" | head -1 | awk '$1 + 0 > 0 { print $2 }')"
  fi

  if [[ -n "$winner" ]]; then
    local tmp="$map.$$.tmp"
    if [[ -f "$map" ]] && awk -v img="$img" '
        substr($0, 1, 1) == "\"" && match($0, /^"[^"]*"/) {
          if (substr($0, 2, RLENGTH - 2) == img) next
        }
        { print }' "$map" > "$tmp" 2>/dev/null; then
      printf '"%s" %s\n' "$img" "$winner" >> "$tmp" && mv -- "$tmp" "$map" 2>/dev/null
    else
      printf '"%s" %s\n' "$img" "$winner" >> "$map" 2>/dev/null
    fi
    rm -f -- "$tmp" 2>/dev/null
    printf '%s\n' "$winner"
  else
    printf 'slate\n'
  fi
}

main() {
  case "${1:-}" in
    help|-h|--help)
      usage
      exit 0
      ;;
  esac

  require_hyprland

  case "${1:-}" in
    switch)
      shift
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      cmd_switch "$1"
      ;;
    get)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      cmd_get
      ;;
    wallpaper-extract)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      cmd_wallpaper_extract
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
