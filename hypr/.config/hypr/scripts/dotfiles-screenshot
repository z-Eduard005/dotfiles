#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly STATE_DIR="$HOME/.local/state/dotfiles/hypr"
readonly SHOT_DIR="$HOME/Pictures/Screenshots"
readonly REGION_FILE="$STATE_DIR/screenshot-region"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - take a screenshot and copy it to the clipboard.

usage: ${BOLD}$(basename "$0")${RESET} [${BOLD}region${RESET}|${BOLD}last-region${RESET}]

  ${BOLD}region${RESET}        select a region to capture
  ${BOLD}last-region${RESET}   reuse the last selected region, or capture the full screen if none
  ${BOLD}-h${RESET}, ${BOLD}--help${RESET}    show this help
EOF
}

FREEZE_PID=""
CURSOR_HW=0

reload_cursor() {
  local theme="${HYPRCURSOR_THEME:-${XCURSOR_THEME:-macOS}}"
  local size="${HYPRCURSOR_SIZE:-${XCURSOR_SIZE:-28}}"
  [[ "$size" =~ ^[0-9]+$ ]] || size=28
  hyprctl setcursor "$theme" "$size" >/dev/null 2>&1 || true
}

use_hardware_cursor() {
  hyprctl eval 'hl.config({ cursor = { no_hardware_cursors = 0 } })' >/dev/null 2>&1 || true
  reload_cursor
  CURSOR_HW=1
}

restore_cursor() {
  [[ "$CURSOR_HW" -eq 1 ]] || return 0
  hyprctl eval 'hl.config({ cursor = { no_hardware_cursors = 1 } })' >/dev/null 2>&1 || true
  reload_cursor
  CURSOR_HW=0
}

cleanup() {
  restore_cursor
  if [[ -n "$FREEZE_PID" ]]; then
    kill "$FREEZE_PID" 2>/dev/null || true
  fi
}

notify_saved() {
  has notify-send || return 0
  notify-send -a "Screenshot" -i "$1" "Screenshot taken" "$SHOT_DIR"
}

# Print the geometry of the last region screenshot, or fail if there is none.
last_geometry() {
  local geometry
  [[ -s "$REGION_FILE" ]] || return 1
  IFS= read -r geometry < "$REGION_FILE" || true
  [[ "$geometry" =~ ^[0-9]+,[0-9]+[[:space:]][0-9]+x[0-9]+$ ]] || return 1
  printf '%s\n' "$geometry"
}

take_screenshot() {
  local mode="$1"
  local filename geometry=""
  require_cmd hyprpicker slurp grim wl-copy

  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/screenshot.lock"
  flock -n 9 || exit 0

  mkdir -p "$SHOT_DIR"
  filename="$SHOT_DIR/ss_$(date +%Y-%m-%d_%H-%M-%S).png"

  trap cleanup EXIT INT TERM

  if [[ "$mode" == region ]]; then
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.2

    geometry="$(slurp -d)" || exit 0
    [[ -n "$geometry" ]] || exit 0
  else
    geometry="$(last_geometry)" || geometry=""
  fi

  use_hardware_cursor
  if [[ -n "$geometry" ]]; then
    grim -g "$geometry" "$filename"
  else
    grim "$filename"
  fi
  restore_cursor

  kill "$FREEZE_PID" 2>/dev/null || true
  FREEZE_PID=""

  if [[ "$mode" == region ]]; then
    printf '%s\n' "$geometry" > "$REGION_FILE"
  fi

  # Release the lock before wl-copy: it forks a background daemon to serve
  # the clipboard, and an inherited lock fd would block all future runs.
  exec 9>&-

  wl-copy --type image/png < "$filename"
  notify_saved "$filename"
}

main() {
  local mode

  case "${1:-}" in
    ""|-h|--help|help)
      usage
      exit 0
      ;;
    region)
      mode=region
      ;;
    last-region)
      mode=last-region
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac

  require_hyprland

  take_screenshot "$mode"
}

main "$@"
