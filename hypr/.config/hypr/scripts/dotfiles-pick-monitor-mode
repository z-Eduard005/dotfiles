#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly LOCK_FILE="$HOME/.local/state/dotfiles/hypr/pick-monitor-mode.lock"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'
readonly PICKER_SCRIPT='
  MENU="$HOME/.local/state/dotfiles/hypr/monitor-modes"
  n=0
  binds=""
  while IFS= read -r _; do
    n=$((n + 1))
    [ "$n" -le 9 ] && binds+="${n}:pos(${n})+accept,"
  done < "$MENU"
  [ "$n" -gt 0 ] || exit 0
  accent=$(dotfiles-accent get)
  choice=$(fzf --header="Select Monitor Mode:" --color="pointer:${accent}" --cycle --height=100% --reverse --no-sort --no-input --disabled --bind "${binds%,}" < "$MENU") || exit 0
  [ -n "$choice" ] || exit 0
  index=${choice%%)*}
  hyprctl eval "require(\"modules.monitors\").apply($index)"
'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - pick a monitor layout from a menu.

usage: ${BOLD}$(basename "$0")${RESET}

Opens an fzf picker with the available monitor modes and applies the selection.
  ${BOLD}-h${RESET}, ${BOLD}--help${RESET}, ${BOLD}help${RESET}   show this help
EOF
}

main() {
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help|help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  fi

  require_hyprland

  require_cmd kitty fzf

  exec 9>"$LOCK_FILE"
  flock -n 9 || exit 0

  kitty --class pick-monitor-mode -o font_size=22 /bin/bash -lc "$PICKER_SCRIPT"
}

main "$@"
