#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" || exit 1

readonly MENU="$HOME/.local/state/dotfiles/hypr/monitor-modes"
readonly CONFIG="$HOME/.config/hypr/modules/monitors.lua"
readonly EDITOR_ACTION="⚙ Edit monitor modes…"
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}$(basename "$0")${RESET} - pick a monitor layout from a menu.

usage: ${BOLD}$(basename "$0")${RESET}

Opens a vicinae picker with the available monitor modes and applies the selection.
  ${BOLD}-h${RESET}, ${BOLD}--help${RESET}, ${BOLD}help${RESET}   show this help
EOF
}

reap_stale_picker() {
  pgrep -f '^vicinae dmenu ' >/dev/null 2>&1 || return 0
  if vicinae state open >/dev/null 2>&1; then
    return 1
  fi
  pkill -f '^vicinae dmenu ' 2>/dev/null || true
}

main() {
  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac

  require_hyprland
  require_cmd vicinae pgrep pkill

  [[ -s "$MENU" ]] || exit 0

  reap_stale_picker || exit 0

  local lines choice
  lines="$(grep -c '' "$MENU")"

  choice="$( { cat "$MENU"; printf '%s\n' "$EDITOR_ACTION"; } |
    vicinae dmenu -f index \
      -p "Choose a layout…" \
      -W 640 -H 360 \
      --no-footer \
      --no-section )" || exit 0
  [[ "$choice" =~ ^[0-9]+$ ]] || exit 0

  if ((choice == lines)); then
    require_cmd gnome-text-editor
    exec gnome-text-editor -s "$CONFIG"
  fi

  hyprctl eval "require(\"modules.monitors\").apply($((choice + 1)))"
}

main "$@"
