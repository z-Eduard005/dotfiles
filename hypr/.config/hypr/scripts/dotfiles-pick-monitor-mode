#!/bin/bash
LOCK="$HOME/.local/state/dotfiles/hypr/pick-monitor-mode.lock"
exec 9>"$LOCK"
flock -n 9 || exit 0

kitty --class pick-monitor-mode -o font_size=22 /bin/bash -lc '
  MENU="$HOME/.local/state/dotfiles/hypr/monitor-modes"
  n=0
  binds=""
  while IFS= read -r _; do
    n=$((n + 1))
    [ "$n" -le 9 ] && binds+="${n}:pos(${n})+accept,"
  done < "$MENU"
  [ "$n" -gt 0 ] || exit 0
  accent=$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null | tr -d "\47")
  case "$accent" in
    blue)   color="#3584e4" ;;
    teal)   color="#2190a4" ;;
    green)  color="#3a944a" ;;
    yellow) color="#c88800" ;;
    orange) color="#ed5b00" ;;
    red)    color="#e62d42" ;;
    pink)   color="#d56199" ;;
    purple) color="#9141ac" ;;
    slate)  color="#6f8396" ;;
    *)      color="#7aa2f7" ;;
  esac
  choice=$(fzf --header="Select Monitor Mode:" --color="pointer:${color}" --cycle --height=100% --reverse --no-sort --no-input --disabled --bind "${binds%,}" < "$MENU") || exit 0
  [ -n "$choice" ] || exit 0
  index=${choice%%)*}
  hyprctl eval "require(\"modules.monitors\").apply($index)"
'
