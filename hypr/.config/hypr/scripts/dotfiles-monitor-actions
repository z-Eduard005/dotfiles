#!/bin/bash
CONF="$HOME/.local/state/dotfiles/hypr/monitors.lua"

usage() {
    echo "Usage: $0 [laptop|monitor high|low|disable] ..." >&2
    exit 1
}

[ $# -eq 0 ] && usage
[ $(( $# % 2 )) -ne 0 ] && usage

external_available() {
    local f
    for f in /sys/class/drm/card*-HDMI-*/status; do
        [ -r "$f" ] || continue
        grep -qx "connected" "$f" 2>/dev/null && return 0
    done
    hyprctl monitors 2>/dev/null | grep -qE "HDMI"
}

TARGETS=()
NEW_ENTRIES=""
SKIPPED=""
while [ $# -gt 0 ]; do
    if [ "$1:$2" = "laptop:disable" ] && ! external_available; then
        SKIPPED=1
        shift 2
        continue
    fi
    case "$1:$2" in
        laptop:high)
            OUTPUT="eDP-1"
            ENTRY='{ output = "eDP-1", mode = "1920x1080@144", position = "-1920x0", scale = "1.0", bitdepth = 10 }'
            ;;
        laptop:low)
            OUTPUT="eDP-1"
            ENTRY='{ output = "eDP-1", mode = "1920x1080@60", position = "-1920x0", scale = "1.0", bitdepth = 10 }'
            ;;
        laptop:disable)
            OUTPUT="eDP-1"
            ENTRY='{ output = "eDP-1", disabled = true }'
            ;;
        monitor:high)
            OUTPUT="HDMI-A-1"
            ENTRY='{ output = "HDMI-A-1", mode = "2560x1440@75", position = "0x0", scale = "1.0", bitdepth = 10 }'
            ;;
        monitor:low)
            OUTPUT="HDMI-A-1"
            ENTRY='{ output = "HDMI-A-1", mode = "1920x1080@75", position = "0x0", scale = "1.0", bitdepth = 10 }'
            ;;
        monitor:disable)
            OUTPUT="HDMI-A-1"
            ENTRY='{ output = "HDMI-A-1", disabled = true }'
            ;;
        *) usage ;;
    esac
    TARGETS+=("$OUTPUT")
    NEW_ENTRIES+="  $ENTRY,"$'\n'
    shift 2
done

if [ -z "$NEW_ENTRIES" ]; then
    notify-send "Monitor mode changed" "laptop disable ignored, monitor unplugged"
    exit 0
fi

# Keep entries for outputs we were not asked to change.
FILTER=()
for t in "${TARGETS[@]}"; do
    FILTER+=(-e "output = \"$t\"")
done

KEPT=""
if [ -f "$CONF" ]; then
    KEPT="$(grep -v "${FILTER[@]}" "$CONF" | grep -E '^[[:space:]]*\{' || true)"
fi

mkdir -p "$(dirname "$CONF")"
{
    echo "-- Generated by dotfiles-monitor-actions; do not edit by hand."
    echo "return {"
    [ -n "$KEPT" ] && printf '%s\n' "$KEPT"
    printf '%s' "$NEW_ENTRIES"
    echo "}"
} > "$CONF.tmp"
mv "$CONF.tmp" "$CONF"

hyprctl reload 2>/dev/null || true
