            "toogle-theme-script": {
               "alias": "theme"
            },
            "update-system": {
               "alias": "update"
            },
            "vicinae-off-script": {
               "alias": "off"
            },
            "vicinae-reboot-script": {
               "alias": "reboot"
            },
            "vicinae-toogle-power-saver-script": {
               "alias": "saver"
            },
            "vicinae-toogle-theme-script": {
               "alias": "theme"
            }
         }
      },
      "calculator": {
         "entrypoints": {
            "refresh-rates": {
               "enabled": false
            }
         }
      },
      "clipboard": {
         "enabled": true,
         "preferences": {
            "ignorePasswords": false,
            "monitoring": true,
            "preserveTagged": true,
            "ignoredApps": [],
            "evictionThreshold": "2592000",
            "eraseOnStartup": false
         },
         "entrypoints": {
            "clear": {
               "enabled": false
            },
            "clear-history": {
               "enabled": false
            }
         }
      },
      "core": {
         "enabled": true,
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
               "enabled": false
            },
            "inspect-local-storage": {
               "enabled": false
            },
            "keybind-settings": {
               "enabled": false
            },
            "list-extensions": {
               "enabled": true
            },
            "manage-fallback": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": true
            },
            "prune-memory": {
               "enabled": false
            },
            "refresh-apps": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-emojis": {
               "enabled": false
            },
            "settings": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            },
            "store": {
               "enabled": true
            }
         }
      },
      "developer": {
         "enabled": true,
         "entrypoints": {
            "create": {
               "enabled": true
            }
         }
      },
      "files": {
         "enabled": true,
         "preferences": {
            "paths": "/home/eduard/*"
         },
         "entrypoints": {
            "search": {
               "alias": "f"
            }
         }
      },
      "font": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "media": {
         "enabled": false
      },
      "power": {
         "enabled": true,
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "lock": {
               "alias": "lock",
               "enabled": true,
               "preferences": {
                  "confirm": false,
                  "customProgram": "hyprlock"
               }
            },
            "logout": {
               "alias": "out",
               "enabled": true,
               "preferences": {
                  "confirm": false,
                  "customProgram": "~/.config/hypr/scripts/power-actions.sh logout"
               }
            },
            "power-off": {
               "alias": "off",
               "enabled": true,
               "preferences": {
                  "confirm": false,
                  "customProgram": "~/.config/hypr/scripts/power-actions.sh shutdown"
               }
            },
            "reboot": {
               "alias": "reboot",
               "enabled": true,
               "preferences": {
                  "confirm": false,
                  "customProgram": "~/.config/hypr/scripts/power-actions.sh reboot"
               }
            },
            "sleep": {
               "enabled": false
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      },
      "scripts": {
         "preferences": {
            "customDirs": []
         }
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "system": {
         "enabled": false,
         "entrypoints": {
            "browse-apps": {
               "enabled": true
            },
            "run": {
               "enabled": true,
               "preferences": {
                  "default-action": "run"
               }
            }
         }
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
