// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "wrap_navigation": true,
   "escape_key_behavior": "close_window",
   "favicon_service": "twenty",
   "search_files_in_root": false,
   "tray": {
      "enabled": false
   },
   "font": {
      "rendering": "native",
      "normal": {
         "family": "SF Pro Rounded",
         "size": 18
      }
   },
   "theme": {
      "light": {
         "name": "adwaita-dynamic",
         "icon_theme": "Adwaita-green"
      },
      "dark": {
         "name": "adwaita-dynamic",
         "icon_theme": "Adwaita-green"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 0.96,
      "client_side_decorations": {
         "border_width": 0,
         "shadow_size": 0
      },
      "compact_mode": {
         "enabled": true
      }
   },
   "favorites": [],
   "providers": {
      "@EvanZhouDev/store.raycast.raycast-gemini": {
         "preferences": {
            "defaultModel": "gemini-2.5-flash-lite",
            "safetyThreshold": "BLOCK_NONE"
         },
         "entrypoints": {
            "aiChat": {
               "enabled": false
            },
            "askAI": {
               "alias": "ai"
            },
            "askAboutScreen": {
               "enabled": false
            },
            "askAboutSelectedScreen": {
               "enabled": false
            },
            "askAboutSelectedText": {
               "enabled": false
            },
            "comment": {
               "enabled": false
            },
            "explain": {
               "enabled": false
            },
            "friendly": {
               "enabled": false
            },
            "grammar": {
               "enabled": false
            },
            "history": {
               "enabled": false
            },
            "longer": {
               "enabled": false
            },
            "professional": {
               "enabled": false
            },
            "shorter": {
               "enabled": false
            },
            "summarize": {
               "enabled": false
            },
            "synonym": {
               "enabled": false
            },
            "translate": {
               "enabled": false
            }
         }
      },
      "@Gelei/store.vicinae.bluetooth": {
         "preferences": {
            "connectionToggleable": false
         }
      },
      "@dagimg-dot/store.vicinae.wifi-commander": {
         "preferences": {
            "network-cli-tool": "nmcli"
         }
      },
      "@gebeto/store.raycast.translate": {
         "preferences": {
            "autoInput": false,
            "lang1": "en",
            "lang2": "ru"
         },
         "entrypoints": {
            "instant-translate-copy": {
               "enabled": false
            },
            "instant-translate-paste": {
               "enabled": false
            },
            "instant-translate-view": {
               "enabled": false
            },
            "quick-translate": {
               "enabled": false
            },
            "translate": {
               "alias": "tr"
            }
         }
      },
      "@maggie/store.raycast.todo-list": {
         "enabled": true,
         "preferences": {
            "completed": "hide_all",
            "nlpParsing": false,
            "sortOrder": "creation_date_ascending"
         },
         "entrypoints": {
            "index": {
               "alias": "todo",
               "enabled": true
            }
         }
      },
      "@mblode/store.raycast.google-search": {
         "entrypoints": {
            "index": {
               "alias": "g"
            },
            "searchSelectText": {
               "enabled": false
            }
         }
      },
      "@muhammetakay/store.raycast.youtube-search": {
         "entrypoints": {
            "index": {
               "alias": "y"
            },
            "searchSelectText": {
               "enabled": false
            }
         }
      },
      "@vimtor/store.raycast.video-downloader": {
         "preferences": {
            "downloadPath": "~/Downloads",
            "homebrewPath": "/opt/homebrew/bin/brew",
            "autoLoadUrlFromClipboard": false,
            "autoLoadUrlFromSelectedText": false,
            "enableBrowserExtensionSupport": false,
            "forceIpv4": false
         }
      },
      "@z-Eduard005/hyprpaper-switcher": {
         "preferences": {
            "wallpaperDir": ""
         }
      },
      "applications": {
         "preferences": {
            "paths": [
               "/home/eduard/.local/share/applications",
               "/var/lib/flatpak/exports/share/applications",
               "/usr/local/share/applications",
               "/usr/share/applications",
               "/var/lib/snapd/desktop/applications"
            ]
         },
         "entrypoints": {
            "proton.vpn.app.gtk": {
               "alias": "vpn"
            },
            "toggle-theme-script": {
               "alias": "theme"
            },
            "toggle-zen-mode": {
               "alias": "zen-mode"
