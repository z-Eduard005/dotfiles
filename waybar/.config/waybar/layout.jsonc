{
  "layer": "top",
  "position": "top",
  "width": "100%",
  "height": 40,
  "margin": "0 0 0 0",

  "group/left": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces"],
  },

  "group/left-hidden-top": {
    "orientation": "horizontal",
    "modules": ["custom/start"],
  },

  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/language",
      "image#wifi",
      "image#bluetooth",
      "group/group-volume",
      "group/group-battery",
      "group/group-temperature",
    ],
  },

  "group/right-hidden-top": {
    "orientation": "horizontal",
    "modules": ["tray"],
  },

  "modules-left": ["group/group-clock", "custom/cava"],
  "modules-center": ["group/left"],
  "modules-right": ["group/right", "group/right-hidden-top"],

  "include": ["~/.config/waybar/modules.jsonc"],
}
