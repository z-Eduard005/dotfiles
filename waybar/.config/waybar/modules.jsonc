{
  "hyprland/workspaces": {
    "format": "{icon} <span></span> {windows}",
    "workspace-taskbar": {
      "enable": true,
      "icon-size": 24,
      "tooltip": false,
    },
    "persistent-workspaces": { "*": 1 },
    "cursor": true,
    "format-icons": {
      "1": "H",
      "2": "J",
      "3": "K",
      "4": "L",
      "5": ";",
      "6": "'",

      "persistent": "",
      "empty": "",
      "tooltip": false,
    },
    "begin": "null",
    "end": "null",
    "tooltip": false,
  },

  "hyprland/window": {
    "max-length": 45,
    "tooltip": false,
  },

  "tray": {
    "icon-size": 20,
    "spacing": 12,
    "cursor": true,
  },

  "temperature": {
    "interval": 10,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0/hwmon",
    "input-filename": "temp3_input",
    "format": "{temperatureC}°",
    "critical-threshold": 90,
    "tooltip": false,
  },

  "battery": {
    "interval": 20,
    "full-at": 100,
    "format-full": "{capacity}%",
    "format": "{capacity}%",
    "format-time": "{H}:{M:02}",
    "format-charging": "{capacity}%",
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "tooltip": false,
  },

  "image#temperature": {
    "size": 24,
    "interval": 10,
    "exec": "~/.config/waybar/scripts/icon-temperature.sh",
    "tooltip": false,
  },

  "image#volume": {
    "size": 24,
    "signal": 8,
    "exec": "~/.config/waybar/scripts/icon-volume.sh",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle; pkill -x -RTMIN+8 waybar",
    "tooltip": false,
  },

  "image#wifi": {
    "size": 24,
    "signal": 9,
    "interval": 30,
    "exec": "~/.config/waybar/scripts/icon-wifi.sh",
    "on-click": "vicinae 'vicinae://launch/@dagimg-dot/store.vicinae.wifi-commander/scan-wifi'",
    "on-click-right": "[ \"$(nmcli radio wifi)\" = enabled ] && nmcli radio wifi off || nmcli radio wifi on; pkill -x -RTMIN+9 waybar",
  },

  "image#bluetooth": {
    "size": 24,
    "signal": 10,
    "exec": "~/.config/waybar/scripts/icon-bluetooth.sh",
    "on-click": "vicinae 'vicinae://launch/@Gelei/store.vicinae.bluetooth/scan'",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on; pkill -x -RTMIN+10 waybar",
  },

  "image#battery": {
    "size": 24,
    "interval": 2,
    "exec": "~/.config/waybar/scripts/icon-battery.sh",
    "tooltip": false,
  },

  "clock": {
    "format": "{:%H:%M - %d.%m.%y %B}",
    "tooltip": false,
  },

  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava-bars.sh",
    "restart-interval": 5,
    "hide-empty-text": true,
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "format-uk": "UA",
  },

  "group/group-volume": {
    "orientation": "horizontal",
    "modules": ["image#volume", "pulseaudio/slider"],
  },

  "group/group-battery": {
    "orientation": "horizontal",
    "modules": ["image#battery", "battery"],
  },

  "group/group-temperature": {
    "orientation": "horizontal",
    "modules": ["image#temperature", "temperature"],
  },

  "custom/clock-icon": {
    "format": "",
    "tooltip": false,
  },

  "group/group-clock": {
    "orientation": "horizontal",
    "modules": ["custom/clock-icon", "clock"],
  },
}
