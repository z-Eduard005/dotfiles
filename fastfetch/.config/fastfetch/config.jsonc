{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fedora.txt",
    "color": {
      "1": "blue",
      "2": "bright_white",
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2,
    },
  },

  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#34} user    {#keys}│",
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    {
      "condition": {
        // Conditional module: only show on non-macOS
        "!system": "macOS",
      },
      "type": "command",
      "keyIcon": "",
      "key": "│{#34} {icon} os age {#keys} │",
      "text": "b=$(stat -c %W /); n=$(date +%s); d=$(( (n - b) / 86400 )); y=$(( d / 365 )); printf '%s - %s days (%s years)' \"$(date -d \"@$b\" '+%d.%m.%Y')\" \"$d\" \"$y\"",
    },
    {
      "key": "│ {#34}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#34} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#34} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#34}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#34} term    {#keys}│",
      "type": "command",
      "text": "t=${TERM_PROGRAM:-$(basename \"$TERM\" | sed 's/^xterm-//')}; tv=$($t --version 2>/dev/null | awk '{print $2}'); s=$(basename \"$SHELL\"); sv=$($s --version 2>/dev/null | awk '{print $1, $2}'); echo \"$t $tv @ $sv\"",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#34}󰢮 gpu     {#keys}│",
      "type": "gpu",
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#34} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
